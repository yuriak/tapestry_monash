+def save_adapter_snapshot(
+    *,
+    model,
+    step: int,
+    save_dir: str,
+    rank: int,
+    extra: dict | None = None,
+) -> None:
+    """Atomically export a lightweight, immutable LoRA-only snapshot.
+
+    The formal M0 runs use DDP, so every rank has a complete adapter and only
+    rank 0 writes. Barriers keep all ranks at the same optimizer boundary.
+    Existing completed snapshots are left untouched, which makes DCP resume
+    safe without rewriting trajectory history.
+    """
+    if not save_dir:
+        raise ValueError("adapter snapshot save_dir must be non-empty")
+
+    if dist.is_available() and dist.is_initialized():
+        dist.barrier()
+
+    if rank == 0:
+        from safetensors.torch import save_file
+
+        final_path = Path(save_dir) / f"step_{step:07d}"
+        tmp_path = Path(f"{final_path}.tmp")
+        complete = final_path / ".complete"
+        adapter_file = final_path / "adapter_model.safetensors"
+        metadata_file = final_path / "meta.json"
+
+        if complete.exists() and adapter_file.is_file() and metadata_file.is_file():
+            logger.info(f"Adapter snapshot already complete → {final_path}")
+        else:
+            _safe_rmtree(str(tmp_path))
+            if final_path.exists():
+                _safe_rmtree(str(final_path))
+            tmp_path.mkdir(parents=True, exist_ok=False)
+
+            lora_sd: dict[str, torch.Tensor] = {}
+            for name, param in model.named_parameters():
+                if "lora_" not in name:
+                    continue
+                clean_name = name.removeprefix("module.")
+                clean_name = re.sub(
+                    r"(lora_[AB])\.[^.]+\.(weight)", r"\1.\2", clean_name
+                )
+                lora_sd[clean_name] = param.detach().cpu().float().contiguous()
+
+            if not lora_sd:
+                _safe_rmtree(str(tmp_path))
+                raise RuntimeError("No LoRA parameters found for adapter snapshot")
+
+            tmp_adapter = tmp_path / "adapter_model.safetensors"
+            save_file(lora_sd, str(tmp_adapter))
+            digest = hashlib.sha256(tmp_adapter.read_bytes()).hexdigest()
+            metadata = {
+                "format": "safetensors",
+                "parameter_count": sum(t.numel() for t in lora_sd.values()),
+                "sha256": digest,
+                "step": int(step),
+                "tensor_count": len(lora_sd),
+            }
+            if extra:
+                metadata.update(extra)
+            (tmp_path / "meta.json").write_text(
+                json.dumps(metadata, indent=2, sort_keys=True) + "\n"
+            )
+            (tmp_path / ".complete").touch()
+            final_path.parent.mkdir(parents=True, exist_ok=True)
+            os.rename(tmp_path, final_path)
+            logger.info(
+                f"Adapter snapshot → {final_path} | tensors={len(lora_sd)} | sha256={digest}"
+            )
+
+    if dist.is_available() and dist.is_initialized():
+        dist.barrier()
+
